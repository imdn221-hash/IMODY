<Window x:Class="IMODY.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY - Hakkında &amp; Kullanım Kılavuzu"
        Width="700"
        Height="600"
        MinWidth="580"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK & VİZYON & GERİ BUTONU -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="IMODY AI Travel Companion"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="Kişiselleştirilmiş akıllı seyahat koçu ve canlı macera rehberi."
                           Margin="24,3,0,0"
                           FontSize="12.5"
                           Foreground="{DynamicResource Theme_Accent}"/>
            </StackPanel>

            <Button Content="← Geri"
                    Width="85"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextSecondary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="12"
                    Cursor="Hand"
                    Click="BackButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="17"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- KULLANIM KILAVUZU (SCROLL) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- MİTOLOJİK HİKAYE: ODYSSEY & ODY -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1.5" CornerRadius="16" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📜 " FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Neden Ody? — Bir Mitolojik Yolculuk Destanı (Odyssey)"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme_Accent}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Homeros'un binlerce yıllık ölümsüz destanı Odyssey (Odysseia); bilinmeyen denizlere yelken açan, antik efsaneleri ve gizemli diyarları zekasıyla keşfeden tarihin en büyük gezgini Odysseus'un destansı yolculuğunu anlatır."
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Foreground="{DynamicResource Theme_TextPrimary}"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Tarihte seyahat etmek sadece bir noktadan diğerine gitmek değil; keşfetmek, öğrenmek ve kendi hikayeni yazmaktır. 'Ody' ismi, işte bu ölümsüz keşif ve macera ruhundan doğdu."
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Foreground="{DynamicResource Theme_TextPrimary}"
                                   Margin="0,0,0,6"/>

                        <Border Background="{DynamicResource Theme_BgSub}" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                            <TextBlock Text="« Her gezgin kendi Odyssey'ini yaşar. Sen nereye gidersen git, Ody senin pusulan ve akıllı yol koçundur. »"
                                       FontStyle="Italic"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme_Accent}"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Giriş Metni -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                    <TextBlock Text="IMODY, seyahat planlamayı klasik listelerden kurtarıp; kişisel ilgi alanlarına, canlı şehir etkinliklerine, mitolojik hikayelere ve kamp hayatta kalma tüyolarına göre yaşayan dinamik bir maceraya dönüştürür."
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="{DynamicResource Theme_TextPrimary}"/>
                </Border>

                <TextBlock Text="📖 IMODY KULLANIM KILAVUZU"
                           FontSize="13.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme_Accent}"
                           Margin="0,4,0,10"/>

                <!-- Adım 1 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1. 🌍 3D Dünya &amp; Spin the World" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <TextBlock Text="Ana sayfadaki 3D dünyayı fareyle tutup serbestçe döndürebilirsin. Nereye gideceğine karar veremiyorsan 'Gideceğim yeri bilmiyorum' kartına tıkla, Ody senin için dünyayı döndürüp bir şehir seçsin."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Adım 2 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2. 📅 Tarih &amp; Gün Sayısı Seçimi" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <TextBlock Text="Seyahat başlangıç tarihini ve kaç gün kalacağını seç. Animasyonlu takvim sistemi rotanı gün gün planlamaya hazırlar."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Adım 3 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="3. 🏨 Konaklama &amp; Kamp Survival Modu" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <TextBlock Text="'Yerim Var' veya 'Yerim Yok' seçeneğiyle ilerle. Yerin yoksa tek tıkla ETS / Trivago üzerinden en iyi otelleri gör. Kamp seçtiğinde en yakın ekipman mağazaları, su kaynakları ve ateş yakma tüyoları plana eklenir."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Adım 4 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="4. 🤖 Ody ile Canlı Sohbet &amp; İlgi Alanları" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <TextBlock Text="Ody sıkıcı formlar yerine seninle samimi sohbet ederek ne tür yemekler sevdiğini, tarihe/mitolojiye mi yoksa fotoğrafçılığa mı meraklı olduğunu anlar."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Adım 5 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="5. 🗺️ İnteraktif Rota &amp; Gece Oyunları" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <TextBlock Text="Oluşturulan 5 günlük planı Ody ile konuşarak her an güncelleyebilir, antik mekanların mitolojik hikayelerini ve gece arkadaşlarınla oynayabileceğin eğlenceli görevleri keşfedebilirsin."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>