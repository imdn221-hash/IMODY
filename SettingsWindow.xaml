<Window x:Class="IMODY.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY - Ayarlar &amp; Temalar"
        Width="540"
        Height="490"
        MinWidth="480"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="22" VerticalAlignment="Center"/>
                <TextBlock Text="Ayarlar &amp; Renk Teması"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_TextPrimary}"/>
            </StackPanel>
            <TextBlock Text="Görünüm paletini ve oturum tercihlerini yönet."
                       Margin="22,2,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Theme_TextSecondary}"/>
        </StackPanel>

        <!-- AYARLAR LİSTESİ -->
        <StackPanel Grid.Row="1">
            <!-- 3'LÜ TEMA SEÇİM KARTLARI -->
            <Border Background="{DynamicResource Theme_BgCard}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="🎨 Tema Modu Seçimi" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                    <TextBlock Text="Seçtiğin tema uygulamanın tüm ekranlarında canlı olarak anında değişir:" FontSize="11" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,2,0,10"/>

                    <UniformGrid Columns="4">
                        <!-- KOZMİK LACİVERT (Varsayılan) -->
                        <Border x:Name="NavyThemeCard" Margin="2" Padding="8,12" CornerRadius="12" Background="#0B132B" BorderBrush="#D6A45A" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="NavyTheme_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Seçim Yuvarlağı (Dolup Boşalan) -->
                                <Grid Width="18" Height="18" Margin="0,0,0,6">
                                    <Ellipse Width="16" Height="16" Stroke="#D6A45A" StrokeThickness="2"/>
                                    <Ellipse x:Name="NavyCheckDot" Width="8" Height="8" Fill="#D6A45A" Visibility="Visible"/>
                                </Grid>
                                <TextBlock Text="🌌 Lacivert" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Varsayılan" FontSize="8.5" Foreground="#D6A45A" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- VİŞNE ÇÜRÜĞÜ (İmza Tema) -->
                        <Border x:Name="CherryThemeCard" Margin="2" Padding="8,12" CornerRadius="12" Background="#2B0717" BorderBrush="#7D4053" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="CherryTheme_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Seçim Yuvarlağı (Dolup Boşalan) -->
                                <Grid Width="18" Height="18" Margin="0,0,0,6">
                                    <Ellipse Width="16" Height="16" Stroke="#D6A45A" StrokeThickness="2"/>
                                    <Ellipse x:Name="CherryCheckDot" Width="8" Height="8" Fill="#D6A45A" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock Text="🍒 Vişne" FontSize="11" FontWeight="Bold" Foreground="#F5E9DD" HorizontalAlignment="Center"/>
                                <TextBlock Text="İmza Tema" FontSize="8.5" Foreground="#D6A45A" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KOYU TEMA (Simsiyah) -->
                        <Border x:Name="DarkThemeCard" Margin="2" Padding="8,12" CornerRadius="12" Background="#0A0A0C" BorderBrush="#2D2D3B" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="DarkTheme_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Seçim Yuvarlağı (Dolup Boşalan) -->
                                <Grid Width="18" Height="18" Margin="0,0,0,6">
                                    <Ellipse Width="16" Height="16" Stroke="#D6A45A" StrokeThickness="2"/>
                                    <Ellipse x:Name="DarkCheckDot" Width="8" Height="8" Fill="#D6A45A" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock Text="🌑 Siyah" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Koyu Mod" FontSize="8.5" Foreground="#A0A5B5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- AÇIK TEMA (Bembeyaz) -->
                        <Border x:Name="LightThemeCard" Margin="2" Padding="8,12" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D8DEE6" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="LightTheme_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Seçim Yuvarlağı (Dolup Boşalan) -->
                                <Grid Width="18" Height="18" Margin="0,0,0,6">
                                    <Ellipse Width="16" Height="16" Stroke="#B88230" StrokeThickness="2"/>
                                    <Ellipse x:Name="LightCheckDot" Width="8" Height="8" Fill="#B88230" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock Text="☀️ Beyaz" FontSize="11" FontWeight="Bold" Foreground="#1A1D24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Açık Mod" FontSize="8.5" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- SES & BİLDİRİM TERCİHİ -->
            <Border Background="{DynamicResource Theme_BgCard}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🔔 Canlı Bildirimler &amp; Sesler"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <TextBlock Text="Şehir etkinlikleri ve Ody tavsiyeleri için uyarılar."
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme_TextSecondary}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <CheckBox x:Name="NotificationsCheckBox"
                              Content="Açık"
                              Foreground="{DynamicResource Theme_Accent}"
                              FontSize="12"
                              IsChecked="True"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- HESAP BİLGİSİ -->
            <Border Background="{DynamicResource Theme_BgCard}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="👤 Aktif Oturum"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <TextBlock x:Name="AccountTextBlock"
                                   Text="gezgin@imody.ai"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme_Accent}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ALT BUTONLAR -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Button Content="🚪 Oturumu Kapat"
                    Width="140"
                    Height="36"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextSecondary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="12"
                    Cursor="Hand"
                    Click="LogoutButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Tamam ✦"
                    Width="130"
                    Height="36"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource Theme_Accent}"
                    Foreground="#2B0717"
                    FontWeight="Bold"
                    FontSize="12"
                    Cursor="Hand"
                    Click="SaveSettingsButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>