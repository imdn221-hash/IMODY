<Window x:Class="IMODY.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY - Gezgin Profili &amp; Rütbeler"
        Width="640"
        Height="620"
        MinWidth="540"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST BAŞLIK & GERİ BUTONU -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="Gezgin Profili"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="Kişisel seyahat kartın, rütben ve başarıların."
                           Margin="22,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Theme_TextSecondary}"/>
            </StackPanel>

            <Button Content="← Geri"
                    Width="85"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextSecondary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="12"
                    Cursor="Hand"
                    Click="BackButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="17"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- SEKME BUTONLARI (TAB SEÇİCİ) -->
        <Border Grid.Row="1" Background="{DynamicResource Theme_BgSub}" CornerRadius="14" Padding="4" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TabProfileBtn"
                        Grid.Column="0"
                        Content="👤 Profil Özeti"
                        Height="34"
                        Background="{DynamicResource Theme_Accent}"
                        Foreground="#2B0717"
                        FontWeight="Bold"
                        FontSize="12"
                        Cursor="Hand"
                        Click="TabProfile_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                </Button>

                <Button x:Name="TabRanksBtn"
                        Grid.Column="1"
                        Content="🏆 Gezgin Seviyeleri (I - V)"
                        Height="34"
                        Background="Transparent"
                        Foreground="{DynamicResource Theme_TextSecondary}"
                        FontWeight="SemiBold"
                        FontSize="12"
                        Cursor="Hand"
                        Click="TabRanks_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- 1. SEKME İÇERİĞİ: PROFİL KARTI & İSTATİSTİKLER -->
        <Grid x:Name="ProfileTabContent" Grid.Row="2" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- PROFİL BİLGİ KARTI & FOTOĞRAF -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme_BgCard}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar / Fotoğraf Ekleme Alanı -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Ellipse x:Name="ProfileImageEllipse"
                                 Width="80"
                                 Height="80"
                                 Fill="#65162F"
                                 Stroke="{DynamicResource Theme_Accent}"
                                 StrokeThickness="2"/>

                        <!-- Varsayılan İkon / Harf -->
                        <TextBlock x:Name="AvatarLetterTextBlock"
                                   Text="👤"
                                   FontSize="32"
                                   Foreground="{DynamicResource Theme_TextPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Fotoğraf Değiştir Butonu -->
                        <Button Content="📷"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-2,-2"
                                Background="{DynamicResource Theme_Accent}"
                                Foreground="#2B0717"
                                FontWeight="Bold"
                                Cursor="Hand"
                                ToolTip="Fotoğrafı Değiştir"
                                Click="ChangePhoto_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Kullanıcı Bilgileri & Derece Rozeti -->
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameTextBlock"
                                       Text="Gezgin"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme_TextPrimary}"/>

                            <!-- RÜTBE ROZETİ -->
                            <Border Background="{DynamicResource Theme_Accent}"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RankBadgeTextBlock"
                                           Text="🎒 Gezgin I"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#2B0717"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="UserEmailTextBlock"
                                   Text="gezgin@imody.ai"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme_TextSecondary}"
                                   Margin="0,3,0,8"/>

                        <!-- XP / Puan İlerleme Çubuğu -->
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mevcut Seyahat Puanı" FontSize="11" Foreground="{DynamicResource Theme_TextSecondary}"/>
                                <TextBlock x:Name="PointsTextBlock" Text="1.450 XP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="RankProgressBar" Value="60" Height="6" Background="{DynamicResource Theme_BgSub}" Foreground="{DynamicResource Theme_Accent}" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- İSTATİSTİKLER -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Kart 1 -->
                <Border Grid.Column="0" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🗺️" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TripsCountTextBlock" Text="6 Rota" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <TextBlock Text="Planlandı" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Kart 2 -->
                <Border Grid.Column="2" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🏛️" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CitiesCountTextBlock" Text="12 Şehir" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <TextBlock Text="Keşfedildi" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Kart 3 -->
                <Border Grid.Column="4" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⛺" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aktif" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <TextBlock Text="Kampçı &amp; Seyyah" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 2. SEKME İÇERİĞİ: 5 SEVİYE VE YOL HARİTASI -->
        <ScrollViewer x:Name="RanksTabContent" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Seviye 1: Gezgin I -->
                <Border x:Name="RankCard1" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎒" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gezgin I: Çaylak Seyyah" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="İlk rotalarını çiz, Ody ile seyahat planlamaya başla." FontSize="11" Foreground="{DynamicResource Theme_TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="0 - 500 XP" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Seviye 2: Gezgin II -->
                <Border x:Name="RankCard2" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏛️" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gezgin II: Şehir Kaşifi" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="Müzeler, tarihi sokaklar ve belediye keşifleri." FontSize="11" Foreground="{DynamicResource Theme_TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="501 - 1.500 XP" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Seviye 3: Gezgin III -->
                <Border x:Name="RankCard3" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⛺" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gezgin III: Doğa &amp; Kampçı" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="Survival modları, çadır kamp rotaları ve su kaynakları." FontSize="11" Foreground="{DynamicResource Theme_TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="1.501 - 3.000 XP" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Seviye 4: Gezgin IV -->
                <Border x:Name="RankCard4" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🌍" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gezgin IV: Dünya Seyyahı" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="Kıtalararası seyahatler, 3D dünya pinleri ve efsaneler." FontSize="11" Foreground="{DynamicResource Theme_TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="3.001 - 6.000 XP" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Seviye 5: Gezgin V -->
                <Border x:Name="RankCard5" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1.5" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👑" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gezgin V: Efsane Gezgin" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_Accent}"/>
                            <TextBlock Text="Dünyanın tüm sırlarını ve gizli rotalarını bilen zirve." FontSize="11" Foreground="{DynamicResource Theme_TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="6.000+ XP" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>