<Window x:Class="IMODY.ExploreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY - Keşfet &amp; Şehir Etkinlikleri"
        Width="1050"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme_BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme_Accent}"/>
                    <Setter Property="Foreground" Value="#2B0717"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme_BgPrimary}">
        <!-- ARKA PLAN GALAKSİ VİDEOSU (PINTEREST GALAXY SWIRL) -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <MediaElement x:Name="GalaxyVideoPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          MediaEnded="GalaxyVideoPlayer_MediaEnded"
                          Stretch="UniformToFill"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          IsMuted="True"
                          Volume="0"
                          SpeedRatio="1.0"
                          Opacity="0.45"/>

            <!-- Karartma & Renk Uyum Katmanı -->
            <Rectangle Fill="{DynamicResource Theme_BgPrimary}" Opacity="0.6"/>

            <!-- Kozmik Parıltılar -->
            <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-100,0" Fill="{DynamicResource Theme_Accent}" Opacity="0.12">
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- İÇERİK IZGARASI -->
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIK & GALAKSİ MERKEZİNDEKİ 3D DÜNYA & BUTONLAR -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol Başlık -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Keşfet &amp; Şehir Etkinlikleri"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme_TextPrimary}"/>
                    </StackPanel>
                    <TextBlock Text="Belediyelerin canlı etkinlikleri, dünya konserleri ve gezgin rotaları."
                               Margin="24,3,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource Theme_TextSecondary}"/>
                </StackPanel>

                <!-- ORTA: GALAKSİNİN MERKEZİNE YERLEŞTİRİLMİŞ 3D DÖNEN DÜNYA KÜRESİ -->
                <Grid Grid.Column="1" Margin="20,0,25,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Galaksi Girdap Çerçevesi -->
                    <Border Width="110" Height="110" CornerRadius="55"
                            Background="#15FFFFFF"
                            BorderBrush="{DynamicResource Theme_Accent}"
                            BorderThickness="1.5"
                            ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                        </Border.Effect>

                        <!-- 3D DÜNYA KÜRESİ -->
                        <Viewport3D x:Name="GlobeViewport">
                            <Viewport3D.Camera>
                                <PerspectiveCamera Position="0,0,3.1" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45"/>
                            </Viewport3D.Camera>
                            
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#707070"/>
                                        <DirectionalLight Color="#FFFFFF" Direction="-1,-0.5,-1"/>
                                        <GeometryModel3D x:Name="GlobeGeometryModel">
                                            <GeometryModel3D.Transform>
                                                <RotateTransform3D>
                                                    <RotateTransform3D.Rotation>
                                                        <AxisAngleRotation3D x:Name="GlobeRotation" Axis="0,1,0" Angle="0"/>
                                                    </RotateTransform3D.Rotation>
                                                </RotateTransform3D>
                                            </GeometryModel3D.Transform>
                                        </GeometryModel3D>
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </Viewport3D>
                    </Border>
                </Grid>

                <!-- Sağ Butonlar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Geri"
                            Width="85"
                            Height="36"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Theme_BgSub}"
                            Foreground="{DynamicResource Theme_TextSecondary}"
                            BorderBrush="{DynamicResource Theme_Border}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Cursor="Hand"
                            Click="BackButton_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18"/></Style></Button.Resources>
                    </Button>

                    <Button Content="＋  Etkinlik Ekle"
                            Height="36"
                            Padding="14,0"
                            Background="{DynamicResource Theme_Accent}"
                            Foreground="#2B0717"
                            FontWeight="Bold"
                            FontSize="12.5"
                            Cursor="Hand"
                            Click="ToggleAddEventPanel_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- YENİ ETKİNLİK GİRİŞ FORMU (Açılır / Kapanır Panel) -->
            <Border x:Name="AddEventBorder"
                    Grid.Row="1"
                    Background="{DynamicResource Theme_BgSub}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="🏛️ Kurumsal / Gezgin Etkinlik Girişi"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme_Accent}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewTitleTextBox"
                                 Grid.Column="0"
                                 Padding="10,8"
                                 Background="{DynamicResource Theme_BgCard}"
                                 Foreground="{DynamicResource Theme_TextPrimary}"
                                 BorderBrush="{DynamicResource Theme_Border}"
                                 Text="Etkinlik Başlığı"/>

                        <TextBox x:Name="NewAuthorTextBox"
                                 Grid.Column="2"
                                 Padding="10,8"
                                 Background="{DynamicResource Theme_BgCard}"
                                 Foreground="{DynamicResource Theme_TextPrimary}"
                                 BorderBrush="{DynamicResource Theme_Border}"
                                 Text="Kurum / Organizatör"/>

                        <TextBox x:Name="NewCityTextBox"
                                 Grid.Column="4"
                                 Padding="10,8"
                                 Background="{DynamicResource Theme_BgCard}"
                                 Foreground="{DynamicResource Theme_TextPrimary}"
                                 BorderBrush="{DynamicResource Theme_Border}"
                                 Text="Şehir"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="NewCategoryComboBox"
                                  Grid.Column="0"
                                  Height="35"
                                  SelectedIndex="0"
                                  Background="{DynamicResource Theme_BgCard}">
                            <ComboBoxItem Content="🏛️ Belediye / Festival"/>
                            <ComboBoxItem Content="🎵 Konser / Gösteri"/>
                            <ComboBoxItem Content="🎒 Gezgin Keşfi"/>
                            <ComboBoxItem Content="⛺ Kamp &amp; Doğa"/>
                        </ComboBox>

                        <TextBox x:Name="NewDateTextBox"
                                 Grid.Column="2"
                                 Padding="10,8"
                                 Background="{DynamicResource Theme_BgCard}"
                                 Foreground="{DynamicResource Theme_TextPrimary}"
                                 BorderBrush="{DynamicResource Theme_Border}"
                                 Text="Tarih &amp; Saat"/>

                        <TextBox x:Name="NewPriceTextBox"
                                 Grid.Column="4"
                                 Padding="10,8"
                                 Background="{DynamicResource Theme_BgCard}"
                                 Foreground="{DynamicResource Theme_TextPrimary}"
                                 BorderBrush="{DynamicResource Theme_Border}"
                                 Text="Ücret (Örn: Ücretsiz)"/>
                    </Grid>

                    <TextBox x:Name="NewContentTextBox"
                             Height="55"
                             Padding="10,8"
                             Margin="0,0,0,12"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Background="{DynamicResource Theme_BgCard}"
                             Foreground="{DynamicResource Theme_TextPrimary}"
                             BorderBrush="{DynamicResource Theme_Border}"
                             Text="Etkinlik veya keşif detaylarını buraya yazın..."/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="İptal"
                                Width="80"
                                Height="32"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                Foreground="{DynamicResource Theme_TextSecondary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CancelAddEvent_Click"/>

                        <Button Content="Yayına Al ✦"
                                Height="32"
                                Padding="16,0"
                                Background="{DynamicResource Theme_Accent}"
                                Foreground="#2B0717"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="SubmitEvent_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- FİLTRELER & LİSTE -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Kategori Filtre Butonları -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="✦ Tümü" Style="{StaticResource FilterButtonStyle}" Click="FilterAll_Click"/>
                    <Button Content="🏛️ Belediyeler &amp; Festivaller" Style="{StaticResource FilterButtonStyle}" Click="FilterMunicipality_Click"/>
                    <Button Content="🎵 Konserler &amp; Gösteriler" Style="{StaticResource FilterButtonStyle}" Click="FilterConcert_Click"/>
                    <Button Content="🎒 Gezgin Rotaları" Style="{StaticResource FilterButtonStyle}" Click="FilterTravelers_Click"/>
                </StackPanel>

                <!-- Akış Kartları -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PostsPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>