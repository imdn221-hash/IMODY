<Window x:Class="IMODY.ExploreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY - Keşfet &amp; Şehir Etkinlikleri"
        Width="920"
        Height="680"
        MinWidth="800"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}">

    <Window.Resources>
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme_BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#65162F"/>
                    <Setter Property="Foreground" Value="#D6A45A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK & GERİ DÖNÜŞ & YENİ ETKİNLİK EKLE BUTONU -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Keşfet &amp; Şehir Etkinlikleri"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="Belediyelerin canlı etkinlikleri, dünya konserleri ve gezgin rotaları."
                           Margin="24,4,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource Theme_TextSecondary}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- GERİ DÖN BUTONU -->
                <Button Content="← Geri"
                        Width="90"
                        Height="38"
                        Margin="0,0,12,0"
                        Background="Transparent"
                        Foreground="{DynamicResource Theme_TextSecondary}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Cursor="Hand"
                        Click="BackButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="19"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- ETKİNLİK EKLE BUTONU -->
                <Button Content="＋  Etkinlik Ekle (B2B)"
                        Width="180"
                        Height="38"
                        Background="{DynamicResource Theme_Accent}"
                        Foreground="#2B0717"
                        FontWeight="Bold"
                        FontSize="13"
                        Cursor="Hand"
                        Click="ToggleAddEventPanel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="19"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- YENİ ETKİNLİK GİRİŞ FORMU (Açılır / Kapanır Panel) -->
        <Border x:Name="AddEventBorder"
                Grid.Row="1"
                Background="#3B0C1E"
                BorderBrush="#895066"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="🏛️ Kurumsal / Gezgin Etkinlik Girişi"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#D6A45A"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewTitleTextBox"
                             Grid.Column="0"
                             Padding="10,8"
                             Background="#2B0717"
                             Foreground="#F5E9DD"
                             BorderBrush="#7D4053"
                             Text="Etkinlik Başlığı (Örn: Travis Scott Konseri)"/>

                    <TextBox x:Name="NewAuthorTextBox"
                             Grid.Column="2"
                             Padding="10,8"
                             Background="#2B0717"
                             Foreground="#F5E9DD"
                             BorderBrush="#7D4053"
                             Text="Kurum / Organizatör (Örn: Buca Belediyesi)"/>

                    <TextBox x:Name="NewCityTextBox"
                             Grid.Column="4"
                             Padding="10,8"
                             Background="#2B0717"
                             Foreground="#F5E9DD"
                             BorderBrush="#7D4053"
                             Text="Şehir (Örn: Londra)"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="NewCategoryComboBox"
                              Grid.Column="0"
                              Height="35"
                              SelectedIndex="0"
                              Background="#2B0717"
                              Foreground="#2B0717">
                        <ComboBoxItem Content="🏛️ Belediye / Festival"/>
                        <ComboBoxItem Content="🎵 Konser / Gösteri"/>
                        <ComboBoxItem Content="🎒 Gezgin Keşfi"/>
                        <ComboBoxItem Content="⛺ Kamp &amp; Doğa"/>
                    </ComboBox>

                    <TextBox x:Name="NewDateTextBox"
                             Grid.Column="2"
                             Padding="10,8"
                             Background="#2B0717"
                             Foreground="#F5E9DD"
                             BorderBrush="#7D4053"
                             Text="Tarih &amp; Saat (Örn: 28 Ağustos - 20:30)"/>

                    <TextBox x:Name="NewPriceTextBox"
                             Grid.Column="4"
                             Padding="10,8"
                             Background="#2B0717"
                             Foreground="#F5E9DD"
                             BorderBrush="#7D4053"
                             Text="Ücret (Örn: Ücretsiz veya £80)"/>
                </Grid>

                <TextBox x:Name="NewContentTextBox"
                         Height="60"
                         Padding="10,8"
                         Margin="0,0,0,12"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Background="#2B0717"
                         Foreground="#F5E9DD"
                         BorderBrush="#7D4053"
                         Text="Etkinlik veya keşif detaylarını buraya yazın..."/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal"
                            Width="90"
                            Height="32"
                            Margin="0,0,10,0"
                            Background="Transparent"
                            Foreground="#D9A6A8"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelAddEvent_Click"/>

                    <Button Content="Yayına Al ✦"
                            Width="120"
                            Height="34"
                            Background="#65162F"
                            Foreground="#F5E9DD"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="SubmitEvent_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- FİLTRELER & LİSTE -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Kategori Filtre Butonları -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="✦ Tümü" Style="{StaticResource FilterButtonStyle}" Click="FilterAll_Click"/>
                <Button Content="🏛️ Belediyeler &amp; Festivaller" Style="{StaticResource FilterButtonStyle}" Click="FilterMunicipality_Click"/>
                <Button Content="🎵 Konserler &amp; Gösteriler" Style="{StaticResource FilterButtonStyle}" Click="FilterConcert_Click"/>
                <Button Content="🎒 Gezgin Rotaları" Style="{StaticResource FilterButtonStyle}" Click="FilterTravelers_Click"/>
            </StackPanel>

            <!-- Akış Kartları -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PostsPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>