<Window x:Class="IMODY.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY"
        Width="520"
        Height="620"
        MinWidth="480"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource Theme_BgPrimary}">
        <Border Width="380"
                Padding="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Theme_BgCard}"
                BorderBrush="{DynamicResource Theme_Border}"
                BorderThickness="1"
                CornerRadius="18">

            <StackPanel>
                <TextBlock Text="IMODY"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_TextPrimary}"/>

                <TextBlock Text="AI TRAVEL COMPANION"
                           Margin="0,4,0,32"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_Accent}"/>

                <TextBlock Text="Adın"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Theme_TextSecondary}"/>

                <TextBox x:Name="NameTextBox"
                         Height="42"
                         Margin="0,0,0,16"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Theme_BgSub}"
                         Foreground="{DynamicResource Theme_TextPrimary}"
                         BorderBrush="{DynamicResource Theme_Border}"/>

                <TextBlock Text="E-posta"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Theme_TextSecondary}"/>

                <TextBox x:Name="EmailTextBox"
                         Height="42"
                         Margin="0,0,0,16"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Theme_BgSub}"
                         Foreground="{DynamicResource Theme_TextPrimary}"
                         BorderBrush="{DynamicResource Theme_Border}"/>

                <TextBlock Text="Şifre"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Theme_TextSecondary}"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             Margin="0,0,0,24"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource Theme_BgSub}"
                             Foreground="{DynamicResource Theme_TextPrimary}"
                             BorderBrush="{DynamicResource Theme_Border}"/>

                <Button Content="Giriş Yap"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="{DynamicResource Theme_Accent}"
                        Foreground="#2B0717"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Login_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Hesap Oluştur"
                        Height="42"
                        Background="Transparent"
                        Foreground="{DynamicResource Theme_TextSecondary}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CreateAccount_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Şifremi Unuttum"
                        Margin="0,16,0,0"
                        Background="Transparent"
                        Foreground="{DynamicResource Theme_Accent}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ForgotPasswordButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>