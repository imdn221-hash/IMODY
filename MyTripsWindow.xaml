<Window x:Class="IMODY.MyTripsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seyahatlerim &amp; Anı Albümüm - IMODY"
        Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Nav & Action Buttons -->
        <Style x:Key="RoundedActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme_Accent}"/>
            <Setter Property="Foreground" Value="#2B0717"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme_BgSub}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme_Accent}"/>
                                <Setter Property="Foreground" Value="#2B0717"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ANA PENCERE GÖVDESİ -->
    <Border Background="{DynamicResource Theme_BgPrimary}"
            BorderBrush="{DynamicResource Theme_Border}"
            BorderThickness="1.5"
            CornerRadius="22"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ÜST BAŞLIK BARI -->
            <Grid Grid.Row="0" Background="{DynamicResource Theme_BgSub}" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Theme_Accent}">
                        <TextBlock Text="📖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Seyahatlerim &amp; Anı Albümüm" Foreground="{DynamicResource Theme_TextPrimary}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Önceki seyahatlerin, gezi notların ve 5 fotoğraflık anı albümün" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Kapatma Butonu -->
                <Button Content="✕"
                        Width="36" Height="36"
                        Margin="0,0,20,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Foreground="{DynamicResource Theme_TextSecondary}"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="18"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- ANA İÇERİK BÖLÜMÜ (SOL LİSTE / SAĞ DETAY) -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL PANEL: SEYAHAT LİSTESİ -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Theme_BgSub}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Başlık & Sayaç -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Kayıtlı Seyahatler" Foreground="{DynamicResource Theme_TextPrimary}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="TripCountText" Text="Toplam 2 seyahat kayıtlı" Foreground="{DynamicResource Theme_Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Seyahat Listesi -->
                        <ListBox x:Name="TripsListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="TripsListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{DynamicResource Theme_BgCard}"
                                                        BorderBrush="{DynamicResource Theme_Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="12"
                                                        Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme_Accent}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.8"/>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme_BgPrimary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme_TextPrimary}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Destination}" Foreground="{DynamicResource Theme_Accent}" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding DateRange}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="10.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="8" Padding="6,3">
                                                <TextBlock Text="{Binding PhotoCountText}" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Yeni Gezi Ekle Butonu -->
                        <Button Grid.Row="2"
                                Content="＋ Yeni Seyahat Ekle"
                                Style="{StaticResource RoundedActionBtn}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0"
                                Click="AddNewTrip_Click"/>
                    </Grid>
                </Border>

                <!-- SAĞ PANEL: SEÇİLİ SEYAHAT DETAYLARI & 5 FOTOĞRAFLIK ALBÜM -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Theme_BgSub}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Üst Bilgi Kartı (Başlık, Rota, Tarih, Yıldız) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Seyahat Başlığı" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TripTitleBox"
                                             Text="Roma &amp; Vatikan Keşfi"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource Theme_TextPrimary}"
                                             Background="{DynamicResource Theme_BgCard}"
                                             BorderBrush="{DynamicResource Theme_Border}"
                                             BorderThickness="1"
                                             Padding="10,6"
                                             Margin="0,4,0,10">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Hedef Şehir / Rota" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBox x:Name="TripDestinationBox"
                                                     Text="Roma, İtalya"
                                                     FontSize="13"
                                                     Foreground="{DynamicResource Theme_TextPrimary}"
                                                     Background="{DynamicResource Theme_BgCard}"
                                                     BorderBrush="{DynamicResource Theme_Border}"
                                                     BorderThickness="1"
                                                     Padding="8,5"
                                                     Margin="0,4,0,0">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Tarih Aralığı" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBox x:Name="TripDateRangeBox"
                                                     Text="14 - 19 Nisan 2026"
                                                     FontSize="13"
                                                     Foreground="{DynamicResource Theme_TextPrimary}"
                                                     Background="{DynamicResource Theme_BgCard}"
                                                     BorderBrush="{DynamicResource Theme_Border}"
                                                     BorderThickness="1"
                                                     Padding="8,5"
                                                     Margin="0,4,0,0">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Puan / Yıldızlar -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                                    <TextBlock Text="Seyahat Puanın" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="Star1" Text="★" FontSize="20" Foreground="{DynamicResource Theme_Accent}" Cursor="Hand" MouseLeftButtonDown="Star_Click" Tag="1" Margin="2,0"/>
                                        <TextBlock x:Name="Star2" Text="★" FontSize="20" Foreground="{DynamicResource Theme_Accent}" Cursor="Hand" MouseLeftButtonDown="Star_Click" Tag="2" Margin="2,0"/>
                                        <TextBlock x:Name="Star3" Text="★" FontSize="20" Foreground="{DynamicResource Theme_Accent}" Cursor="Hand" MouseLeftButtonDown="Star_Click" Tag="3" Margin="2,0"/>
                                        <TextBlock x:Name="Star4" Text="★" FontSize="20" Foreground="{DynamicResource Theme_Accent}" Cursor="Hand" MouseLeftButtonDown="Star_Click" Tag="4" Margin="2,0"/>
                                        <TextBlock x:Name="Star5" Text="★" FontSize="20" Foreground="{DynamicResource Theme_Accent}" Cursor="Hand" MouseLeftButtonDown="Star_Click" Tag="5" Margin="2,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- SEYAHAT NOTLARI & GÜNLÜK -->
                            <StackPanel Margin="0,4,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📝 " FontSize="13"/>
                                    <TextBlock Text="Seyahat Notlarım &amp; Gezi Günlüğü" Foreground="{DynamicResource Theme_TextPrimary}" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TripNotesBox"
                                         Height="100"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="12.5"
                                         Foreground="{DynamicResource Theme_TextPrimary}"
                                         Background="{DynamicResource Theme_BgCard}"
                                         BorderBrush="{DynamicResource Theme_Border}"
                                         BorderThickness="1"
                                         Padding="10">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></TextBox.Resources>
                                </TextBox>
                            </StackPanel>

                            <!-- 📸 5 FOTOĞRAFLIK SEYAHAT ANILARI ALBÜMÜ -->
                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📸 " FontSize="14"/>
                                        <TextBlock Text="Seyahat Albümü" Foreground="{DynamicResource Theme_TextPrimary}" FontSize="13.5" FontWeight="Bold"/>
                                        <TextBlock Text=" (Maksimum 5 Fotoğraf)" Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AlbumSlotCounter" Text="2 / 5 Yüklendi" Foreground="{DynamicResource Theme_Accent}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 5 Slot Grid -->
                                <UniformGrid Columns="5" Margin="0,4,0,0">
                                    <!-- Slot 1 -->
                                    <Border x:Name="PhotoSlot1" Height="130" Margin="4" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True" Cursor="Hand">
                                        <Grid>
                                            <Image x:Name="Img1" Stretch="UniformToFill" MouseLeftButtonDown="ViewPhoto_Click" Tag="0"/>
                                            <StackPanel x:Name="Placeholder1" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="UploadPhoto_Click" Tag="0">
                                                <TextBlock Text="＋" FontSize="24" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="1. Fotoğraf" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="DelBtn1" Content="🗑️" Width="26" Height="26" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#80000000" Foreground="#FFFFFF" BorderThickness="0" Visibility="Collapsed" Click="DeletePhoto_Click" Tag="0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Slot 2 -->
                                    <Border x:Name="PhotoSlot2" Height="130" Margin="4" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True" Cursor="Hand">
                                        <Grid>
                                            <Image x:Name="Img2" Stretch="UniformToFill" MouseLeftButtonDown="ViewPhoto_Click" Tag="1"/>
                                            <StackPanel x:Name="Placeholder2" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="UploadPhoto_Click" Tag="1">
                                                <TextBlock Text="＋" FontSize="24" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="2. Fotoğraf" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="DelBtn2" Content="🗑️" Width="26" Height="26" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#80000000" Foreground="#FFFFFF" BorderThickness="0" Visibility="Collapsed" Click="DeletePhoto_Click" Tag="1">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Slot 3 -->
                                    <Border x:Name="PhotoSlot3" Height="130" Margin="4" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True" Cursor="Hand">
                                        <Grid>
                                            <Image x:Name="Img3" Stretch="UniformToFill" MouseLeftButtonDown="ViewPhoto_Click" Tag="2"/>
                                            <StackPanel x:Name="Placeholder3" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="UploadPhoto_Click" Tag="2">
                                                <TextBlock Text="＋" FontSize="24" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="3. Fotoğraf" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="DelBtn3" Content="🗑️" Width="26" Height="26" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#80000000" Foreground="#FFFFFF" BorderThickness="0" Visibility="Collapsed" Click="DeletePhoto_Click" Tag="2">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Slot 4 -->
                                    <Border x:Name="PhotoSlot4" Height="130" Margin="4" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True" Cursor="Hand">
                                        <Grid>
                                            <Image x:Name="Img4" Stretch="UniformToFill" MouseLeftButtonDown="ViewPhoto_Click" Tag="3"/>
                                            <StackPanel x:Name="Placeholder4" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="UploadPhoto_Click" Tag="3">
                                                <TextBlock Text="＋" FontSize="24" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="4. Fotoğraf" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="DelBtn4" Content="🗑️" Width="26" Height="26" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#80000000" Foreground="#FFFFFF" BorderThickness="0" Visibility="Collapsed" Click="DeletePhoto_Click" Tag="3">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Slot 5 -->
                                    <Border x:Name="PhotoSlot5" Height="130" Margin="4" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True" Cursor="Hand">
                                        <Grid>
                                            <Image x:Name="Img5" Stretch="UniformToFill" MouseLeftButtonDown="ViewPhoto_Click" Tag="4"/>
                                            <StackPanel x:Name="Placeholder5" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="UploadPhoto_Click" Tag="4">
                                                <TextBlock Text="＋" FontSize="24" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="5. Fotoğraf" FontSize="10.5" Foreground="{DynamicResource Theme_TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="DelBtn5" Content="🗑️" Width="26" Height="26" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#80000000" Foreground="#FFFFFF" BorderThickness="0" Visibility="Collapsed" Click="DeletePhoto_Click" Tag="4">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- ALT AKSİYON BUTONLARI (KAYDET & SİL) -->
                            <Grid Margin="0,10,0,0">
                                <Button Content="🗑️ Bu Seyahati Sil"
                                        Style="{StaticResource SecondaryBtn}"
                                        HorizontalAlignment="Left"
                                        Click="DeleteTrip_Click"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SaveFeedbackText" Text="✓ Değişiklikler kaydedildi" Foreground="{DynamicResource Theme_Accent}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0"/>
                                    <Button Content="💾 Değişiklikleri Kaydet"
                                            Style="{StaticResource RoundedActionBtn}"
                                            Click="SaveTrip_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 🔍 FULLSCREEN LIGHTBOX MODAL (FOTOĞRAF BÜYÜTÜCÜ) -->
            <Grid x:Name="LightboxModal" Grid.RowSpan="2" Background="#D9000000" Visibility="Collapsed" MouseLeftButtonDown="CloseLightbox_Click">
                <Border Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1.5" CornerRadius="16" MaxWidth="850" MaxHeight="600" Margin="40" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="LightboxImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Background="#90000000" Foreground="#FFFFFF" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand" Click="CloseLightbox_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
