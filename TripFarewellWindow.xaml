<Window x:Class="IMODY.TripFarewellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İyi Seyahatler! - IMODY"
        Width="780"
        Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <!-- ANA GÖVDE -->
    <Border Background="{DynamicResource Theme_BgPrimary}"
            BorderBrush="{DynamicResource Theme_Accent}"
            BorderThickness="2"
            CornerRadius="24"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="45" ShadowDepth="12" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <!-- KOZMİK IŞILTI KATMANLARI -->
            <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0" Fill="{DynamicResource Theme_Accent}" Opacity="0.12">
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="350" Height="350" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Fill="#48CAE4" Opacity="0.10">
                <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
            </Ellipse>

            <!-- İÇERİK -->
            <Grid Margin="36,32,36,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. BAŞLIK VE KUTLAMA -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Theme_Accent}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="✈️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="İyi Seyahatler! 🌟"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme_TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DestinationSubtitleText"
                               Text="Roma seyahatin için her şey eksiksiz hazırlandı."
                               FontSize="14"
                               Foreground="{DynamicResource Theme_Accent}"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 2. ANILAR & FOTOĞRAFLAR HATIRLATMA KARTI -->
                <Border Grid.Row="1"
                        Background="{DynamicResource Theme_BgSub}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1.2"
                        CornerRadius="18"
                        Padding="24"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="📸 " FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Fotoğraf Eklemeyi &amp; Not Tutmayı Unutma!"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme_TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Seyahatin bittiğinde yaşadığın tüm güzellikleri, tattığın sokak lezzetlerini ve anılarını taze tutmak için 'Seyahatlerim' bölümüne gezi notlarını ve en güzel 5 fotoğrafını eklemeyi sakın unutma! 📖✨"
                                   FontSize="13.5"
                                   LineHeight="21"
                                   Foreground="{DynamicResource Theme_TextSecondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,14"/>

                        <Border Background="{DynamicResource Theme_BgCard}"
                                BorderBrush="{DynamicResource Theme_Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,7"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡 İpucu: " Foreground="{DynamicResource Theme_Accent}" FontWeight="Bold" FontSize="11.5"/>
                                <TextBlock Text="Seyahat albümün cihazında güvenle saklanır ve dilediğin zaman büyütüp inceleyebilirsin." Foreground="{DynamicResource Theme_TextSecondary}" FontSize="11.5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. AKSİYON BUTONLARI -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="📖 Seyahatlerime Git"
                            Height="42"
                            Padding="20,0"
                            Margin="0,0,12,0"
                            Background="{DynamicResource Theme_Accent}"
                            Foreground="#2B0717"
                            FontWeight="Bold"
                            FontSize="13"
                            Cursor="Hand"
                            Click="GoToMyTrips_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="21"/></Style></Button.Resources>
                    </Button>

                    <Button Content="🏠 Ana Sayfaya Dön"
                            Height="42"
                            Padding="18,0"
                            Margin="0,0,12,0"
                            Background="{DynamicResource Theme_BgSub}"
                            Foreground="{DynamicResource Theme_TextPrimary}"
                            BorderBrush="{DynamicResource Theme_Border}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Cursor="Hand"
                            Click="GoHome_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="21"/></Style></Button.Resources>
                    </Button>

                    <Button Content="Planı İncele ✕"
                            Height="42"
                            Padding="16,0"
                            Background="Transparent"
                            Foreground="{DynamicResource Theme_TextSecondary}"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Cursor="Hand"
                            Click="CloseDialog_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
