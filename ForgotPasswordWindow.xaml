<Window x:Class="IMODY.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre yenile"
        Width="480"
        Height="460"
        MinWidth="440"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#2B0717">

    <Grid>
        <Border Width="360"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#3B0C1E"
                BorderBrush="#895066"
                BorderThickness="1"
                CornerRadius="18">

            <StackPanel>
                <TextBlock Text="Şifreni yenile"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F5E9DD"/>

                <TextBlock Text="Kayıtlı e-posta adresini ve yeni şifreni gir."
                           Margin="0,8,0,24"
                           TextWrapping="Wrap"
                           Foreground="#D9A6A8"/>

                <TextBlock Text="E-posta"
                           Margin="0,0,0,6"
                           Foreground="#D9A6A8"/>

                <TextBox x:Name="EmailTextBox"
                         Height="42"
                         Margin="0,0,0,16"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Background="#2B0717"
                         Foreground="#F5E9DD"
                         BorderBrush="#895066"/>

                <TextBlock Text="Yeni şifre"
                           Margin="0,0,0,6"
                           Foreground="#D9A6A8"/>

                <PasswordBox x:Name="NewPasswordBox"
                             Height="42"
                             Margin="0,0,0,22"
                             Padding="12,0"
                             Background="#2B0717"
                             Foreground="#F5E9DD"
                             BorderBrush="#895066"/>

                <Button Content="Şifreyi yenile"
                        Height="42"
                        Background="#65162F"
                        Foreground="#F5E9DD"
                        BorderThickness="0"
                        Click="ResetPasswordButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>