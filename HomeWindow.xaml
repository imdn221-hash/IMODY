<Window x:Class="IMODY.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IMODY - Ana Sayfa"
        Width="1000"
        Height="650"
        MinWidth="850"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5E9DD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#D6A45A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ülke Rozeti Stili (Büyük ve Belirgin) -->
        <Style x:Key="CountryPinStyle" TargetType="Button">
            <Setter Property="Background" Value="#DF3B0C1E"/>
            <Setter Property="Foreground" Value="#F5E9DD"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#D6A45A"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#65162F"/>
                    <Setter Property="Foreground" Value="#D6A45A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Şehir Rozeti Stili (Yakınlaşınca Açılan Şık Şehir İğnesi) -->
        <Style x:Key="CityPinStyle" TargetType="Button">
            <Setter Property="Background" Value="#DF65162F"/>
            <Setter Property="Foreground" Value="#F5E9DD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#E8DAD1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6A45A"/>
                    <Setter Property="Foreground" Value="#2B0717"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme_BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- ÜST BAR -->
        <Grid Grid.Row="0" Background="{DynamicResource Theme_BgPrimary}" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Theme_Accent}">
                    <TextBlock Text="O" Foreground="#2B0717" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="IMODY" Foreground="{DynamicResource Theme_TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="AI TRAVEL COMPANION" Foreground="{DynamicResource Theme_Accent}" FontSize="7.5" FontWeight="SemiBold" Margin="1,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0">
                <Button Content="← Geri"
                        Width="82" Height="36"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        Foreground="{DynamicResource Theme_TextSecondary}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BackButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="18"/></Style>
                    </Button.Resources>
                </Button>

                <Button Content="👤"
                        Width="38" Height="38"
                        Background="Transparent"
                        Foreground="{DynamicResource Theme_TextPrimary}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1"
                        FontSize="16"
                        Cursor="Hand"
                        Click="ProfileButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ANA ALAN: 3D DÜNYA VE ARAYÜZ -->
        <Grid Grid.Row="1">
            <!-- DERİN UZAY, NEBULA VE PARILDAYAN YILDIZLAR KATMANI -->
            <Canvas x:Name="SpaceBackgroundCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

            <!-- GERÇEKÇİ UZAY / ATMOSFER IŞIMASI (NEBULA HALO GLOW) -->
            <Grid IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Dış Nebula Mavi -->
                <Ellipse Width="540" Height="540" Fill="#0D2B4D" Opacity="0.45">
                    <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
                </Ellipse>
                <!-- İç Kozmik Parıltı -->
                <Ellipse Width="420" Height="420" Fill="#1A4A7A" Opacity="0.38">
                    <Ellipse.Effect><BlurEffect Radius="75"/></Ellipse.Effect>
                </Ellipse>
                <!-- Tematik Işık -->
                <Ellipse Width="350" Height="350" Fill="{DynamicResource Theme_BgCard}" Opacity="0.55">
                    <Ellipse.Effect><BlurEffect Radius="50"/></Ellipse.Effect>
                </Ellipse>
                <!-- Atmosfer İnce Çember -->
                <Ellipse Width="290" Height="290" Stroke="#4682B4" StrokeThickness="1.8" Opacity="0.35">
                    <Ellipse.Effect><BlurEffect Radius="18"/></Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- 3D DÜNYA (WPF 3D - Standart, Canlı, Dönüşümlü, Fareyle Çevrilebilir & Yakınlaştırılabilir) -->
            <Viewport3D x:Name="WorldViewport"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MouseLeftButtonDown="WorldView_MouseLeftButtonDown"
                        MouseMove="WorldView_MouseMove"
                        MouseLeftButtonUp="WorldView_MouseLeftButtonUp"
                        MouseWheel="WorldView_MouseWheel"
                        Cursor="SizeAll">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="WorldCamera" Position="0,0,3.3" LookDirection="0,0,-3.3" UpDirection="0,1,0" FieldOfView="45"/>
                </Viewport3D.Camera>

                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup x:Name="EarthModelGroup">
                            <AmbientLight Color="#444444"/>
                            <!-- Güneş Işığı (Sol Üstten Doğal Vuruş) -->
                            <DirectionalLight Color="#FFF8EE" Direction="-1.2, -0.6, -1.8"/>
                            <!-- Atmosfer Kenar Işıması (Mavi & Altın Ton) -->
                            <DirectionalLight Color="#336699" Direction="1.2, 0.4, 1.2"/>
                            <DirectionalLight Color="#D6A45A" Direction="0.5, 1.0, -0.5"/>
                            
                            <GeometryModel3D x:Name="EarthGeometryModel"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>

            <!-- EXPLORE THE GLOBE: GERÇEK COĞRAFİ KONUMA GÖRE DÖNEN VE ÇIKAN DİNAMİK PİNLER -->
            <Canvas x:Name="ExplorePinsCanvas" Visibility="Collapsed" IsHitTestVisible="True" ClipToBounds="True"/>

            <!-- SPİN MODUNDA BÜYÜK ODY BİLGİLENDİRME YAZISI -->
            <Border x:Name="SpinInfoOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Theme_BgCard}" CornerRadius="20" Padding="30,20" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎰 ODY DÜNYAYI DÖNDÜRÜYOR..." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SpinStatusTextBlock" Text="Şehir seçiliyor..." FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- EXPLORE MODUNDA ALT BİLGİ VE ZOOM ÇUBUĞU -->
            <Border x:Name="ExploreBottomBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Background="{DynamicResource Theme_BgCard}" CornerRadius="16" Padding="18,10" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ZoomStatusTextBlock" Text="🌎 Dünyayı fareyle çevir — Avustralya'dan Jamaika'ya her ülke tam coğrafi konumunda görünür!" Foreground="{DynamicResource Theme_TextPrimary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Normal Moda Dön ✕" Background="{DynamicResource Theme_BgSub}" Foreground="{DynamicResource Theme_Accent}" FontWeight="SemiBold" Padding="12,5" BorderThickness="0" Cursor="Hand" Click="ExitExploreMode_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- KARŞILAMA VE DİNAMİK YAZI ALANI -->
            <Canvas x:Name="WelcomeAnimationCanvas"
                    Width="1100" Height="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,35,0,0"
                    IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="WelcomeTitleTransform"/>
                </Canvas.RenderTransform>
            </Canvas>

            <!-- ALT PANEL: ARAMA VE SEÇENEK KARTLARI -->
            <StackPanel x:Name="RoutePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,175,0,0"
                        Opacity="0">

                <!-- Arama Kutusu -->
                <Border Width="480" Height="54" CornerRadius="27" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="⌕" FontSize="22" Foreground="{DynamicResource Theme_Accent}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="50,0,85,0" FontSize="15" Foreground="{DynamicResource Theme_TextPrimary}"
                                 CaretBrush="{DynamicResource Theme_Accent}" VerticalContentAlignment="Center"
                                 Text="Bir şehir veya rota ara (Örn: Roma, Tokyo)..."
                                 GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" KeyDown="SearchTextBox_KeyDown"/>
                        <Button Content="Git →"
                                Width="60" Height="36"
                                HorizontalAlignment="Right" Margin="0,0,9,0"
                                Background="{DynamicResource Theme_Accent}" Foreground="#2B0717"
                                FontWeight="Bold" FontSize="13" Cursor="Hand"
                                Click="StartTripButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2 SEÇENEK PANELİ: GİDECEĞİM YERİ BİLMİYORUM -->
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="✦  Gideceğim Yeri Bilmiyorum (Ody Bana Seçenek Sunsun)"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <Grid Width="480">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Seçenek 1: Spin the World -->
                        <Border Grid.Column="0"
                                Height="75" CornerRadius="16"
                                Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="SpinTheWorld_Click">
                            <Grid Margin="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🎰 Spin the World" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Theme_TextPrimary}"/>
                                    <TextBlock Text="Dünya dönsün, Ody şansına bir şehir seçsin!" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Seçenek 2: Explore the Globe -->
                        <Border Grid.Column="2"
                                Height="75" CornerRadius="16"
                                Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="ExploreTheGlobe_Click">
                            <Grid Margin="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🌎 Explore the Globe" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Theme_TextPrimary}"/>
                                    <TextBlock Text="Dünyayı sen çevir, şehirleri keşfet ve seç!" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ALT NAVİGASYON -->
        <Grid Grid.Row="2" Background="{DynamicResource Theme_BgCard}" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="⌂  Ana Sayfa" Width="125" Style="{StaticResource NavButtonStyle}" Foreground="{DynamicResource Theme_Accent}"/>
                <Button Content="＋  Oluştur" Width="125" Style="{StaticResource NavButtonStyle}" Click="CreateButton_Click"/>
                <Button Content="◈  Keşfet" Width="125" Style="{StaticResource NavButtonStyle}" Click="ExploreButton_Click"/>
                <Button Content="ⓘ  Hakkında" Width="125" Style="{StaticResource NavButtonStyle}" Click="AboutButton_Click"/>
                <Button Content="⚙  Ayarlar" Width="125" Style="{StaticResource NavButtonStyle}" Click="SettingsButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>