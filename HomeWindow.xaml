<Window x:Class="IMODY.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMODY"
        mc:Ignorable="d"
        Title="HomeWindow" Height="450" Width="800">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <TextBlock Text="IMODY"
                   FontSize="28"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="30,0,0,0"
                   HorizontalAlignment="Left"/>
            <Button
    Content="👤"
    Width="40"
    Height="40"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Margin="0,0,30,0"/>
            
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="Hoş Geldin"
                   FontSize="40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Background="White">

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

                <Button Content="Ana Sayfa"
                    Width="120"
                    Margin="10"/>

                <Button Content="Oluştur"
                    Width="120"
                    Margin="10"/>

                <Button Content="Galeri"
                    Width="120"
                    Margin="10"/>

                <Button Content="Ayarlar"
                    Width="120"
                    Margin="10"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>
