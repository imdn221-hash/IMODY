<Window x:Class="IMODY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMODY"
        mc:Ignorable="d"
        Title="IMODY - AI Seyahat Koçu"
        Height="720"
        Width="1220"
        MinHeight="640"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Ana buton -->
        <Style x:Key="StartButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="245"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Foreground" Value="#2B0717"/>
            <Setter Property="Background" Value="{DynamicResource Theme_Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="29">
                            <Border.Effect>
                                <DropShadowEffect Color="#16050C"
                                                  BlurRadius="25"
                                                  ShadowDepth="6"
                                                  Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Küçük navigasyon butonları -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme_Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True" Background="{DynamicResource Theme_BgPrimary}">
        <!-- DİNAMİK AMBİENT PARILTILAR -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="650" Height="650" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-180,0" Fill="{DynamicResource Theme_BgCard}" Opacity="0.55">
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="450" Height="450" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-160" Fill="{DynamicResource Theme_Accent}" Opacity="0.12">
                <Ellipse.Effect><BlurEffect Radius="85"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- ÜST LOGO -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="48,35,0,0">
            <Border Width="44"
                    Height="44"
                    CornerRadius="22"
                    Background="{DynamicResource Theme_Accent}">
                <TextBlock Text="O"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2B0717"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="IMODY"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme_TextPrimary}"/>
                <TextBlock Text="AI TRAVEL COMPANION"
                           FontSize="8.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_Accent}"
                           Margin="1,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- SAĞ ÜST MENÜ -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,37,45,0">
            <Button Content="Keşfet"
                    Style="{StaticResource NavButtonStyle}"
                    Click="ExploreButton_Click"/>
            <Button Content="Hakkında"
                    Style="{StaticResource NavButtonStyle}"
                    Click="AboutButton_Click"/>
            <Button Content="⚙"
                    Width="40"
                    Height="40"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextPrimary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="16"
                    Cursor="Hand"
                    Click="SettingsButton_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style></Button.Resources>
            </Button>
            <Button Content="👤"
                    Width="40"
                    Height="40"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextPrimary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="16"
                    Cursor="Hand"
                    Click="ProfileButton_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style></Button.Resources>
            </Button>
        </StackPanel>

        <!-- ANA İÇERİK -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="540"/>
            </Grid.ColumnDefinitions>

            <!-- SOL TARAF (METİNLER VE AKSİYON) -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,25,0">
                <!-- Dinamik Karşılama Rozeti -->
                <Border Background="{DynamicResource Theme_BgSub}" CornerRadius="12" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OdyGreetingTextBlock"
                                   Text="GÜNAYDIN! YOLCULUK BURADA BAŞLAR"
                                   Foreground="{DynamicResource Theme_Accent}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Ana başlık -->
                <TextBlock Text="Ben Ody."
                            FontSize="68"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Theme_TextPrimary}"/>
                <TextBlock Text="Sen nereye,"
                            FontSize="32"
                            Foreground="{DynamicResource Theme_Accent}"
                            FontStyle="Italic"
                            Margin="3,2,0,0"/>
                <TextBlock Text="ben oraya."
                            FontSize="32"
                            Foreground="{DynamicResource Theme_Accent}"
                            FontStyle="Italic"
                            Margin="3,0,0,0"/>

                <!-- Buton -->
                <Button Content="Keşfe başla   →"
                        Style="{StaticResource StartButtonStyle}"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Left"
                        Click="StartButton_Click"/>

                <!-- Küçük Güven Mesajı -->
                <StackPanel Orientation="Horizontal" Margin="5,18,0,0">
                    <TextBlock Text="✦" Foreground="{DynamicResource Theme_Accent}" FontSize="11"/>
                    <TextBlock Text="  Sana göre. Senin için. Canlı seyahat koçun."
                               Foreground="{DynamicResource Theme_TextSecondary}"
                               FontSize="12"
                               Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Ody & Odyssey Mitolojik Hikaye Butonu -->
                <Border Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" Margin="2,14,0,0" Cursor="Hand" MouseLeftButtonDown="AboutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜 " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Ody (Odyssey) İsminin Mitolojik Hikayesi →" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme_Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SAĞ TARAF / 3D DÖNEN DÜNYA KÜRESİ VE CANLI HAREKET EDEN ODY -->
            <Grid Grid.Column="1" Width="540" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Arka Plan Kozmik Parıltı & Atmosferik Halka -->
                <Ellipse Width="330" Height="330" Stroke="{DynamicResource Theme_Accent}" StrokeThickness="1.5" Opacity="0.25">
                    <Ellipse.Effect><BlurEffect Radius="24"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="270" Height="270" Stroke="#48CAE4" StrokeThickness="1" Opacity="0.2">
                    <Ellipse.Effect><BlurEffect Radius="14"/></Ellipse.Effect>
                </Ellipse>

                <!-- 3D DÜNYA KÜRESİ (VIEWPORT3D) -->
                <Border Width="240"
                        Height="240"
                        CornerRadius="120"
                        Background="{DynamicResource Theme_BgCard}"
                        BorderBrush="{DynamicResource Theme_Border}"
                        BorderThickness="1.5"
                        ClipToBounds="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
                    </Border.Effect>
                    
                    <Viewport3D x:Name="GlobeViewport">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,0,3.2" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#606060"/>
                                    <DirectionalLight Color="#FFFFFF" Direction="-1,-0.5,-1"/>
                                    <GeometryModel3D x:Name="GlobeGeometryModel">
                                        <GeometryModel3D.Transform>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="GlobeRotation" Axis="0,1,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </GeometryModel3D.Transform>
                                    </GeometryModel3D>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                </Border>

                <!-- ODY CANLI İSKELET / KATMAN KUKLA ANİMASYONU -->
                <Grid x:Name="OdyPuppetContainer"
                      Width="320"
                      Height="340"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,0,0"
                      Cursor="Hand"
                      MouseEnter="Ody_MouseEnter"
                      MouseLeave="Ody_MouseLeave"
                      MouseLeftButtonDown="Ody_MouseLeftButtonDown">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="OdyFloatTranslate" X="0" Y="0"/>
                            <ScaleTransform x:Name="OdyMasterScale" ScaleX="1" ScaleY="1" CenterX="160" CenterY="170"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Katman 1: Kuyruk & Yüzgeç (Dalgalanma Hareketi) -->
                    <Image x:Name="OdyTailImage"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5, 0.58">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="OdyTailRotate" Angle="0"/>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Katman 2: Gövde, Kafa & Saçlar (Nefes Alma & Salınım) -->
                    <Image x:Name="OdyTorsoImage"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5, 0.60">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="OdyTorsoRotate" Angle="0"/>
                                <ScaleTransform x:Name="OdyTorsoScale" ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Katman 3: Sağ Kol & Altın Pusula (El Sallama & Pusula Gösterisi) -->
                    <Image x:Name="OdyArmImage"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.60, 0.42">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="OdyArmRotate" Angle="0"/>
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect Color="#E5A93C" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                        </Image.Effect>
                    </Image>

                    <!-- Ody İnteraktif Konuşma Baloncuğu -->
                    <Border x:Name="OdySpeechBubble"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Background="{DynamicResource Theme_BgSub}"
                            BorderBrush="{DynamicResource Theme_Accent}"
                            BorderThickness="1.2"
                            CornerRadius="14"
                            Padding="12,7"
                            Opacity="0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧜‍♀️ " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OdySpeechText" Text="Sen nereye, ben oraya! ✨" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ALT SLOGAN -->
        <TextBlock Text="Hayal et. Planla. Yola çık."
                   FontSize="12.5"
                   FontStyle="Italic"
                   Foreground="{DynamicResource Theme_TextSecondary}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,48,28"/>

        <!-- ALT İNCE ÇİZGİ -->
        <Border Height="1"
                Background="{DynamicResource Theme_Border}"
                Opacity="0.4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="48,0,48,17"/>
    </Grid>
</Window>