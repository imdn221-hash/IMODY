<Window x:Class="IMODY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMODY"
        mc:Ignorable="d"
        Title="IMODY - AI Seyahat Koçu"
        Height="720"
        Width="1220"
        MinHeight="640"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Ana buton -->
        <Style x:Key="StartButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="245"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Foreground" Value="#2B0717"/>
            <Setter Property="Background" Value="{DynamicResource Theme_Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="29">
                            <Border.Effect>
                                <DropShadowEffect Color="#16050C"
                                                  BlurRadius="25"
                                                  ShadowDepth="6"
                                                  Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Küçük navigasyon butonları -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme_Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True" Background="{DynamicResource Theme_BgPrimary}">
        <!-- DİNAMİK AMBİENT PARILTILAR -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="650" Height="650" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-180,0" Fill="{DynamicResource Theme_BgCard}" Opacity="0.55">
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="450" Height="450" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-160" Fill="{DynamicResource Theme_Accent}" Opacity="0.12">
                <Ellipse.Effect><BlurEffect Radius="85"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- ÜST LOGO -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="48,35,0,0">
            <Border Width="44"
                    Height="44"
                    CornerRadius="22"
                    Background="{DynamicResource Theme_Accent}">
                <TextBlock Text="O"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2B0717"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="IMODY"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme_TextPrimary}"/>
                <TextBlock Text="AI TRAVEL COMPANION"
                           FontSize="8.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_Accent}"
                           Margin="1,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- SAĞ ÜST MENÜ -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,37,45,0">
            <Button Content="Keşfet"
                    Style="{StaticResource NavButtonStyle}"
                    Click="ExploreButton_Click"/>
            <Button Content="Hakkında"
                    Style="{StaticResource NavButtonStyle}"
                    Click="AboutButton_Click"/>
            <Button Content="⚙"
                    Width="40"
                    Height="40"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextPrimary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="16"
                    Cursor="Hand"
                    Click="SettingsButton_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style></Button.Resources>
            </Button>
            <Button Content="👤"
                    Width="40"
                    Height="40"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextPrimary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="16"
                    Cursor="Hand"
                    Click="ProfileButton_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style></Button.Resources>
            </Button>
        </StackPanel>

        <!-- ANA İÇERİK -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- SOL TARAF (METİNLER VE AKSİYON) -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,30,0">
                <!-- Dinamik Karşılama Rozeti -->
                <Border Background="{DynamicResource Theme_BgSub}" CornerRadius="12" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OdyGreetingTextBlock"
                                   Text="GÜNAYDIN! YOLCULUK BURADA BAŞLAR"
                                   Foreground="{DynamicResource Theme_Accent}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Ana başlık -->
                <TextBlock Text="Ben Ody."
                            FontSize="68"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Theme_TextPrimary}"/>
                <TextBlock Text="Sen nereye,"
                            FontSize="32"
                            Foreground="{DynamicResource Theme_Accent}"
                            FontStyle="Italic"
                            Margin="3,2,0,0"/>
                <TextBlock Text="ben oraya."
                            FontSize="32"
                            Foreground="{DynamicResource Theme_Accent}"
                            FontStyle="Italic"
                            Margin="3,0,0,0"/>

                <!-- Buton -->
                <Button Content="Keşfe başla   →"
                        Style="{StaticResource StartButtonStyle}"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Left"
                        Click="StartButton_Click"/>

                <!-- Küçük Güven Mesajı -->
                <StackPanel Orientation="Horizontal" Margin="5,18,0,0">
                    <TextBlock Text="✦" Foreground="{DynamicResource Theme_Accent}" FontSize="11"/>
                    <TextBlock Text="  Sana göre. Senin için. Canlı seyahat koçun."
                               Foreground="{DynamicResource Theme_TextSecondary}"
                               FontSize="12"
                               Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Ody & Odyssey Mitolojik Hikaye Butonu -->
                <Border Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" Margin="2,14,0,0" Cursor="Hand" MouseLeftButtonDown="AboutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜 " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Ody (Odyssey) İsminin Mitolojik Hikayesi →" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme_Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SAĞ TARAF / CANLI ODY SİNEMATİK VİDEO PORTALI -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Arka Plan Kozmik Parıltı & Atmosferik Halka -->
                <Ellipse Width="370" Height="370" Stroke="{DynamicResource Theme_Accent}" StrokeThickness="1.5" Opacity="0.35">
                    <Ellipse.Effect><BlurEffect Radius="26"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="330" Height="330" Stroke="#48CAE4" StrokeThickness="1.2" Opacity="0.25">
                    <Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect>
                </Ellipse>

                <!-- CANLI ODY VİDEO PORTALI (MEDIAELEMENT) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="310"
                            Height="310"
                            CornerRadius="155"
                            Background="{DynamicResource Theme_BgCard}"
                            BorderBrush="{DynamicResource Theme_Accent}"
                            BorderThickness="2.5"
                            ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="10" Opacity="0.55"/>
                        </Border.Effect>
                        
                        <MediaElement x:Name="OdyVideoPlayer"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      MediaEnded="OdyVideoPlayer_MediaEnded"
                                      Stretch="UniformToFill"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsMuted="True"
                                      Volume="0"/>
                    </Border>

                    <!-- Video Değiştirme Butonları (Video 1 & Video 2) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="BtnVideo1"
                                Content="🎬 1. Sahne"
                                Height="30"
                                Padding="12,4"
                                FontSize="11.5"
                                FontWeight="Bold"
                                Background="{DynamicResource Theme_Accent}"
                                Foreground="#2B0717"
                                BorderThickness="0"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Click="BtnVideo1_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnVideo2"
                                Content="✨ 2. Sahne"
                                Height="30"
                                Padding="12,4"
                                FontSize="11.5"
                                FontWeight="Bold"
                                Background="{DynamicResource Theme_BgSub}"
                                Foreground="{DynamicResource Theme_TextPrimary}"
                                BorderBrush="{DynamicResource Theme_Border}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="BtnVideo2_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ALT SLOGAN -->
        <TextBlock Text="Hayal et. Planla. Yola çık."
                   FontSize="12.5"
                   FontStyle="Italic"
                   Foreground="{DynamicResource Theme_TextSecondary}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,48,28"/>

        <!-- ALT İNCE ÇİZGİ -->
        <Border Height="1"
                Background="{DynamicResource Theme_Border}"
                Opacity="0.4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="48,0,48,17"/>
    </Grid>
</Window>