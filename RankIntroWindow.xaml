<Window x:Class="IMODY.RankIntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY - Gezgin Kariyeri ve Rütbe Sistemi"
        Width="780"
        Height="620"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK & AÇIKLAMA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="✦ " Foreground="{DynamicResource Theme_Accent}" FontSize="26" VerticalAlignment="Center"/>
                <TextBlock Text="IMODY Gezgin Rütbeleri &amp; Seviyeleri"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme_TextPrimary}"/>
            </StackPanel>
            <TextBlock Text="Her oluşturduğun rota, keşfettiğin şehir ve tamamladığın macera ile XP kazanıp rütbe atlarsın!"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource Theme_TextSecondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- 5 SEVİYE KARTLARI (YOL HARİTASI) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Seviye 1 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎒" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="SEVİYE 1: Çaylak Seyyah (Gezgin I)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="Yolculuğa ilk adım. İlk rota planlarını oluşturup Ody ile seyahat koçluğunu deneyimle." FontSize="12" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Theme_BgSub}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="0 - 500 XP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Seviye 2 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏛️" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="SEVİYE 2: Şehir Kaşifi (Gezgin II)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="Kültürel zenginlikler, müzeler, yerel belediye etkinlikleri ve gizli sokak lezzetleri." FontSize="12" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Theme_BgSub}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="501 - 1.500 XP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Seviye 3 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⛺" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="SEVİYE 3: Doğa &amp; Kampçı (Gezgin III)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="Hayatta kalma (Survival) modları, su kaynakları, çadır kamp alanları ve doğa yürüyüşleri." FontSize="12" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Theme_BgSub}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="1.501 - 3.000 XP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Seviye 4 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🌍" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="SEVİYE 4: Dünya Seyyahı (Gezgin IV)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                            <TextBlock Text="Kıtalararası uçuşlar, 3D dünya üzerinde 10'dan fazla ülke keşfi ve mitolojik efsaneler." FontSize="12" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Theme_BgSub}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="3.001 - 6.000 XP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Seviye 5 -->
                <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1.5" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👑" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="SEVİYE 5: Efsane Gezgin (Gezgin V)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                            <TextBlock Text="Dünyanın her köşesini bilen, tüm gece oyunlarını ve antik gizemleri tamamlamış zirvedeki kaşif." FontSize="12" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Theme_Accent}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="6.000+ XP" FontSize="11" FontWeight="Bold" Foreground="#2B0717"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ALT BİLGİ & ANLADIM BUTONU -->
        <Border Grid.Row="2" Padding="0,8,0,0">
            <Grid>
                <TextBlock Text="💡 Rütbelerini ve seviye ilerlemeni istediğin an Profilim sekmesinden takip edebilirsin."
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{DynamicResource Theme_TextSecondary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button Content="Maceraya Başla! 🚀"
                        Width="190"
                        Height="42"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Theme_Accent}"
                        Foreground="#2B0717"
                        FontWeight="Bold"
                        FontSize="13.5"
                        Cursor="Hand"
                        Click="StartAdventure_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
