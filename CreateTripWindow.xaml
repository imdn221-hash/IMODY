<Window x:Class="IMODY.CreateTripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMODY - Seyahat Planlayıcı"
        Width="1150"
        Height="720"
        MinWidth="950"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme_BgPrimary}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Seçim Kartı Stili -->
        <Style x:Key="OptionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#38200C1C"/>
            <Setter Property="BorderBrush" Value="#66D6A45A"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Çip Buton Stili -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme_BgSub}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme_Accent}"/>
                    <Setter Property="Foreground" Value="#2B0717"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme_BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- ÇARKLARIN DÖNDÜĞÜ SİNEMATİK ARKA PLAN (TAM EKRANA OTURTULMUŞ & AKICI 0.55X) -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <MediaElement x:Name="WaterVideoPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          MediaEnded="WaterVideoPlayer_MediaEnded"
                          Stretch="UniformToFill"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          IsMuted="True"
                          Volume="0"
                          SpeedRatio="0.55"
                          Opacity="0.95"/>

            <!-- İnce Karartma Katmanı (Yazılar kristal netliğinde) -->
            <Rectangle Fill="{DynamicResource Theme_BgPrimary}" Opacity="0.12"/>
        </Grid>

        <!-- ÜST BAR -->
        <Grid Grid.Row="0" Margin="30,0,30,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Theme_Accent}">
                    <TextBlock Text="O" FontSize="19" FontWeight="Bold" Foreground="#2B0717" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderDestinationText" Text="ROMA SEYAHATİ" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                    <TextBlock Text="ODY AI TATİL KOÇU" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Theme_Accent}"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="BackButton"
                    Content="← Geri"
                    Width="85"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource Theme_TextSecondary}"
                    BorderBrush="{DynamicResource Theme_Border}"
                    BorderThickness="1"
                    FontSize="12"
                    Cursor="Hand"
                    Click="Back_Click">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- ORTA İÇERİK ALANI (ADIM ADIM DEĞİŞEN PANELLER) -->
        <Grid Grid.Row="1" Margin="40,10">
            <!-- ÜST SORU BAŞLIĞI -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Border Background="{DynamicResource Theme_BgSub}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center">
                    <TextBlock x:Name="StepBadge"
                               Text="ADIM 1 / 5"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme_Accent}"/>
                </Border>
                <TextBlock x:Name="QuestionText"
                           Text="Seyahatin ne zaman başlıyor?"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme_TextPrimary}"
                           Margin="0,8,0,0"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- 1. ADIM: TARİH SEÇİMİ (TARİH VE KUMSAATİ ANİMASYONU) -->
            <!-- ========================================================= -->
            <StackPanel x:Name="DatePanel" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource OptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="🛫 GİDİŞ TARİHİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                            <DatePicker x:Name="DepartureDatePicker" Margin="0,10,0,0" Height="36" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="{DynamicResource Theme_Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Border Grid.Column="2" Style="{StaticResource OptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="🛬 DÖNÜŞ TARİHİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                            <DatePicker x:Name="ReturnDatePicker" Margin="0,10,0,0" Height="36" SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="DateAnimationStatusText"
                           Text="⏳ Tarihleri seçtiğinde Ody seyahat takvimini hazırlayacak."
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{DynamicResource Theme_TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- 2. ADIM: KİŞİ SAYISI -->
            <!-- ========================================================= -->
            <UniformGrid x:Name="PeoplePanel" Visibility="Collapsed" Columns="4" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="PeopleCard1" Style="{StaticResource OptionCardStyle}" Margin="8" MouseLeftButtonDown="People1_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="1 Kişi" FontSize="16" FontWeight="Bold" Foreground="#F5E9DD" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                        <TextBlock Text="Tek Başına" FontSize="11" Foreground="#AFA0A5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PeopleCard2" Style="{StaticResource OptionCardStyle}" Margin="8" MouseLeftButtonDown="People2_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👥" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="2 Kişi" FontSize="16" FontWeight="Bold" Foreground="#F5E9DD" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                        <TextBlock Text="Çift / Arkadaş" FontSize="11" Foreground="#AFA0A5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PeopleCard3" Style="{StaticResource OptionCardStyle}" Margin="8" MouseLeftButtonDown="People3_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎒" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="3–5 Kişi" FontSize="16" FontWeight="Bold" Foreground="#F5E9DD" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                        <TextBlock Text="Küçük Ekip" FontSize="11" Foreground="#AFA0A5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PeopleCard4" Style="{StaticResource OptionCardStyle}" Margin="8" MouseLeftButtonDown="People4_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="6+ Kişi" FontSize="16" FontWeight="Bold" Foreground="#F5E9DD" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                        <TextBlock Text="Gezgin Grubu" FontSize="11" Foreground="#AFA0A5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ========================================================= -->
            <!-- 3. ADIM: KONAKLAMA (YERİM VAR / YERİM YOK & LİNKLER & KAMP) -->
            <!-- ========================================================= -->
            <StackPanel x:Name="AccommodationPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760" Margin="10,0,10,0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEÇENEK 1: YERİM VAR -->
                    <Border x:Name="AccHavePlaceCard" Grid.Column="0" Style="{StaticResource OptionCardStyle}" MouseLeftButtonDown="AccHavePlace_Click" Cursor="Hand">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Doldurulabilir Radyo Noktası -->
                                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="2" VerticalAlignment="Center" Background="{DynamicResource Theme_BgSub}">
                                    <Ellipse x:Name="AccHavePlaceDot" Width="10" Height="10" Fill="{DynamicResource Theme_Accent}" Visibility="Collapsed"/>
                                </Border>
                                
                                <TextBlock Grid.Column="1" Text="Yerim Var" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Otel, daire veya konaklama yerimi ayarladım. Ody rotayı kaldığım yerden başlatsın."
                                       FontSize="11.5" LineHeight="16" Foreground="{DynamicResource Theme_TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SEÇENEK 2: YERİM YOK -->
                    <Border x:Name="AccNeedPlaceCard" Grid.Column="2" Style="{StaticResource OptionCardStyle}" MouseLeftButtonDown="AccNeedPlace_Click" Cursor="Hand">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Doldurulabilir Radyo Noktası -->
                                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="2" VerticalAlignment="Center" Background="{DynamicResource Theme_BgSub}">
                                    <Ellipse x:Name="AccNeedPlaceDot" Width="10" Height="10" Fill="{DynamicResource Theme_Accent}" Visibility="Collapsed"/>
                                </Border>
                                
                                <TextBlock Grid.Column="1" Text="Yerim Yok (Bana Yer Bul)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Kalacak yerim yok. Bana otel/daire fırsatlarını göster veya Kamp &amp; Survival modunu aç."
                                       FontSize="11.5" LineHeight="16" Foreground="{DynamicResource Theme_TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- YERİM VAR SEÇİLDİĞİNDE AÇILAN ALT ALAN -->
                <Border x:Name="AccHavePlaceSubPanel" Visibility="Collapsed" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🏨 Kaldığın Otel / Semt (İsteğe Bağlı):" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                        <Grid Margin="0,6,0,0">
                            <TextBox x:Name="HotelNameInputTextBox"
                                     Height="38"
                                     Background="{DynamicResource Theme_BgSub}"
                                     Foreground="{DynamicResource Theme_TextPrimary}"
                                     BorderBrush="{DynamicResource Theme_Border}"
                                     BorderThickness="1"
                                     Padding="12,8"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     TextChanged="HotelNameInputTextBox_TextChanged"/>
                            <TextBlock x:Name="HotelNamePlaceholder"
                                       Text="Örn: Kolezyum yakınında Grand Hotel veya Kadıköy Moda"
                                       FontSize="12.5"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource Theme_TextSecondary}"
                                       Opacity="0.65"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- YERİM YOK SEÇİLDİĞİNDE AÇILAN YÖNLENDİRME VE KAMP PANELİ -->
                <Border x:Name="AccDetailsSubPanel" Visibility="Collapsed" Background="#4A1026" BorderBrush="#D6A45A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🏨 Otel &amp; Konaklama Fırsatlarını Canlı İncele:" FontWeight="Bold" FontSize="13" Foreground="#F5E9DD"/>
                        <TextBlock Text="Aşağıdaki butonlara tıklayarak seçtiğin şehir için en uygun otel ve daireleri tek tıkla görebilirsin:" FontSize="11" Foreground="#D9A6A8" Margin="0,2,0,8"/>
                        
                        <!-- Yönlendirme Link Butonları -->
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="🔗 Trivago Otelleri" Height="32" Width="145" Background="#3B0C1E" Foreground="#D6A45A" BorderBrush="#7D4053" BorderThickness="1" Margin="0,0,8,8" Cursor="Hand" Click="OpenTrivago_Click"/>
                            <Button Content="🔗 ETS Tur Fırsatları" Height="32" Width="150" Background="#3B0C1E" Foreground="#D6A45A" BorderBrush="#7D4053" BorderThickness="1" Margin="0,0,8,8" Cursor="Hand" Click="OpenEts_Click"/>
                            <Button Content="🔗 Booking.com" Height="32" Width="135" Background="#3B0C1E" Foreground="#D6A45A" BorderBrush="#7D4053" BorderThickness="1" Margin="0,0,8,8" Cursor="Hand" Click="OpenBooking_Click"/>
                            <Button Content="🔗 Airbnb Evleri" Height="32" Width="135" Background="#3B0C1E" Foreground="#D6A45A" BorderBrush="#7D4053" BorderThickness="1" Margin="0,0,8,8" Cursor="Hand" Click="OpenAirbnb_Click"/>
                        </WrapPanel>

                        <!-- Kamp Survival Modu -->
                        <Border Background="#2B0717" CornerRadius="10" Padding="12" BorderBrush="#7D4053" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⛺ Doğa &amp; Kamp Survival Modu" FontWeight="Bold" FontSize="13" Foreground="#F5E9DD"/>
                                    <TextBlock Text="Otele para vermeyip çadır kuracaksan seç! Ody rotana en yakın su kaynakları, süpermarketler ve rüzgar tüyolarını ekler."
                                               FontSize="11" LineHeight="16" Foreground="#D9A6A8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="SelectCampModeButton" Grid.Column="1" Content="🏕️ Kampı Seç" Height="36" Width="125" Margin="10,0,0,0" Background="#65162F" Foreground="#F5E9DD" FontWeight="SemiBold" BorderBrush="#D6A45A" BorderThickness="1" Cursor="Hand" Click="SelectCampMode_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- 4. ADIM: ODY İLE DOĞRUDAN CANLI SOHBET (İLGİ ALANLARI) -->
            <!-- ========================================================= -->
            <Grid x:Name="InterestChatPanel" Visibility="Collapsed" Width="720" Height="410" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Style="{StaticResource OptionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ody Karşılama Başlığı -->
                        <Border Grid.Row="0" Background="{DynamicResource Theme_BgSub}" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🤖" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Ody ile Seyahat Sohbeti" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}" FontSize="13.5"/>
                                    <TextBlock x:Name="OdyChatIntroText"
                                               Text="Selam! Nelerden hoşlandığını bana anlat, sana özel bir rota çizeyim."
                                               FontSize="11.5" Foreground="{DynamicResource Theme_TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sohbet Akışı Mesajları -->
                        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <StackPanel x:Name="ChatHistoryPanel"/>
                        </ScrollViewer>

                        <!-- Kullanıcı Mesaj Girişi -->
                        <Grid Grid.Row="2">
                            <TextBox x:Name="UserChatInputTextBox"
                                     Height="42"
                                     Background="{DynamicResource Theme_BgSub}"
                                     Foreground="{DynamicResource Theme_TextPrimary}"
                                     BorderBrush="{DynamicResource Theme_Border}"
                                     BorderThickness="1"
                                     Padding="14,10,80,10"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     GotFocus="ChatInput_GotFocus"
                                     LostFocus="ChatInput_LostFocus"
                                     KeyDown="ChatInput_KeyDown"/>
                            <Button Content="Gönder ↵"
                                    Width="70"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource Theme_Accent}"
                                    Foreground="#2B0717"
                                    FontWeight="Bold"
                                    FontSize="11.5"
                                    Cursor="Hand"
                                    Click="SendChatMessage_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- 5. ADIM: GÜN KUTULARI (1. GÜN, 2. GÜN...), GÖRSELLER, FOTO & OYUN MODU -->
            <!-- ========================================================= -->
            <Grid x:Name="PlanDisplayPanel" Visibility="Collapsed" Width="880" Height="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Style="{StaticResource OptionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ÜST GÜN KUTULARI (1. GÜN | 2. GÜN | 3. GÜN...) -->
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                            <StackPanel x:Name="DayBoxesContainer" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <!-- SEÇİLEN GÜNÜN ZENGİN İÇERİĞİ VEYA TÜM GÜNLERİN ÖZETİ -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <Grid>
                                <!-- TÜM SEYAHATİN GÜN GÜN ÖZETİ & ULAŞIM REHBERİ PANELİ -->
                                <StackPanel x:Name="TripSummaryListPanel" Visibility="Visible"/>

                                <!-- Seçilen Günün Detaylı Kartları -->
                                <StackPanel x:Name="DayDetailCardsPanel" Visibility="Collapsed">
                                    <!-- 1. Kart: Gidilecek Yerler & Günün Rota Listesi -->
                                    <Border Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Rota / Keşif Fotoğrafı -->
                                            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1">
                                                <Image x:Name="MorningBreakfastImage" Stretch="UniformToFill"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="📍 GÜNÜN ROTASI &amp; GİDİLECEK YERLER LİSTESİ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_Accent}"/>
                                                <TextBlock x:Name="MorningText" Text="Şehrin görülmesi gereken en popüler noktaları ve ikonik mekanları..." FontSize="12" LineHeight="18" Foreground="{DynamicResource Theme_TextPrimary}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                                <Border Background="{DynamicResource Theme_BgCard}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="MorningTransitText" Text="🚶‍♂️ Yürüme mesafesinde" FontSize="11" Foreground="{DynamicResource Theme_Accent}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Öğle Kartı (Kültür Fotoğrafı & Ulaşım Tüyosu) -->
                                    <Border Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1">
                                                <Image x:Name="AfternoonImage" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="ÖĞLE: Kültür, Tarih &amp; Keşif" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_Accent}"/>
                                                <TextBlock x:Name="AfternoonText" Text="Şehrin ikonik müzeleri ve antik sokakları..." FontSize="12" LineHeight="17" Foreground="{DynamicResource Theme_TextPrimary}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                                <Border Background="{DynamicResource Theme_BgCard}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="AfternoonTransitText" Text="🚌 Otobüs / Metro ile 10 dk" FontSize="11" Foreground="{DynamicResource Theme_Accent}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Akşam Kartı (Gün Batımı, Akşam Yemeği Fotoğrafı & Ulaşım Tüyosu) -->
                                    <Border Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1">
                                                <Image x:Name="EveningImage" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="AKŞAM: Gün Batımı &amp; Akşam Yemeği" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme_Accent}"/>
                                                <TextBlock x:Name="EveningText" Text="Manzara seyir noktası ve geleneksel akşam yemeği..." FontSize="12" LineHeight="17" Foreground="{DynamicResource Theme_TextPrimary}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                                <Border Background="{DynamicResource Theme_BgCard}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="EveningTransitText" Text="🚶‍♂️ 12 dk sahil / sokak yürüyüşü" FontSize="11" Foreground="{DynamicResource Theme_Accent}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ÖZEL MODAL BUTONLARI: FOTOĞRAF TÜYOLARI, LEZZET KEŞFİ & OYUN MODU -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="OpenPhotoTipsBtn" Grid.Column="0" Height="38" Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" Cursor="Hand" Click="OpenPhotoTips_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📸 " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Fotoğraf Tüyoları" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme_TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="OpenFoodDiscoveryBtn" Grid.Column="2" Height="38" Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" Cursor="Hand" Click="OpenFoodDiscovery_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🍴 " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lezzet &amp; Sokak Tatları" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme_Accent}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="OpenGameModeBtn" Grid.Column="4" Height="38" Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" Cursor="Hand" Click="OpenGameMode_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🎲 " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GameModeBtnText" Text="Oyun Modu" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme_TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- ODY İLE PLANI CANLI DEĞİŞTİRME / SOHBET ÇUBUĞU -->
                        <Border Grid.Row="3" Background="{DynamicResource Theme_BgSub}" BorderBrush="{DynamicResource Theme_Border}" BorderThickness="1" CornerRadius="12" Padding="8">
                            <Grid>
                                <TextBox x:Name="PlanReviseTextBox"
                                         Height="36"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource Theme_TextPrimary}"
                                         FontSize="12.5"
                                         Padding="10,6,120,6"
                                         VerticalContentAlignment="Center"
                                         GotFocus="ReviseInput_GotFocus"
                                         LostFocus="ReviseInput_LostFocus"
                                         KeyDown="ReviseInput_KeyDown"/>
                                <Button Content="Ody'ye Söyle ✦"
                                        Width="110"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,4,0"
                                        Background="{DynamicResource Theme_Accent}"
                                        Foreground="#2B0717"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Cursor="Hand"
                                        Click="RevisePlanWithOdy_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- PLAN TAMAMLAMA & İYİ SEYAHATLER KUTLAMA BUTONU -->
                        <Button Grid.Row="4"
                                Content="🚀  Planı Tamamla &amp; Yola Çık! →"
                                Height="40"
                                Margin="0,10,0,0"
                                Background="{DynamicResource Theme_Accent}"
                                Foreground="#2B0717"
                                FontWeight="Bold"
                                FontSize="13"
                                Cursor="Hand"
                                Click="OpenFarewell_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ALT DEVAM BUTONU -->
        <Grid Grid.Row="2" Margin="30,0,30,0">
            <Button x:Name="NextButton"
                    Content="Devam Et →"
                    Width="210"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#D6A45A"
                    Foreground="#2B0717"
                    FontWeight="Bold"
                    FontSize="15"
                    Cursor="Hand"
                    Click="NextButton_Click">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="24"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
        <!-- ========================================================= -->
        <!-- FOTOĞRAF TÜYOLARI MODALI (MEKAN BAZLI & SABAH/AKŞAM POZLARI) -->
        <!-- ========================================================= -->
        <Grid x:Name="PhotoTipsModal" Grid.RowSpan="3" Visibility="Collapsed" Background="#C8000000">
            <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1.5" CornerRadius="18" Padding="24" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📸 " FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Mekan Bazlı Fotoğraf &amp; Poz Rehberi" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme_TextPrimary}"/>
                        </StackPanel>
                        <TextBlock Text="Ody'den gidilecek her nokta için ayrı ayrı sabah ve akşam/gece poz &amp; ışık tüyoları:" FontSize="11.5" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <TextBlock x:Name="PhotoTipsModalText" Text="Fotoğraf tüyoları yükleniyor..." FontSize="12.5" LineHeight="20" Foreground="{DynamicResource Theme_TextPrimary}" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Kapat" Width="100" Height="34" HorizontalAlignment="Right" Background="{DynamicResource Theme_Accent}" Foreground="#2B0717" FontWeight="Bold" Cursor="Hand" Click="ClosePhotoTips_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- KİŞİ SAYISINA ÖZEL OYUN MODU MODALI -->
        <!-- ========================================================= -->
        <Grid x:Name="GameModeModal" Grid.RowSpan="3" Visibility="Collapsed" Background="#C8000000">
            <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1.5" CornerRadius="18" Padding="22" Width="620" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎲 " FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameModeModalHeader" Text="Oyun Modu &amp; Görevler" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                        </StackPanel>
                        <TextBlock Text="Yapay zekanın kişi sayısına ve mekana göre ürettiği eğlenceli seyahat oyunları:" FontSize="11.5" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <TextBlock x:Name="GameModeModalText" Text="Oyunlar hazırlanıyor..." FontSize="12.5" LineHeight="19" Foreground="{DynamicResource Theme_TextPrimary}" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Harika, Anladım! 🚀" Width="160" Height="34" HorizontalAlignment="Right" Background="{DynamicResource Theme_Accent}" Foreground="#2B0717" FontWeight="Bold" Cursor="Hand" Click="CloseGameMode_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- YÖRESEL LEZZET & SOKAK TATLARI MODALI -->
        <!-- ========================================================= -->
        <Grid x:Name="FoodDiscoveryModal" Grid.RowSpan="3" Visibility="Collapsed" Background="#C8000000">
            <Border Background="{DynamicResource Theme_BgCard}" BorderBrush="{DynamicResource Theme_Accent}" BorderThickness="1.5" CornerRadius="18" Padding="22" Width="620" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🍴 " FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FoodModalHeader" Text="Yöresel Lezzet Keşfi &amp; Sokak Tatları" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme_Accent}"/>
                        </StackPanel>
                        <TextBlock Text="Gezerken ayaküstü tadabileceğin o şehre özgü en popüler lezzetler ve mekanlar:" FontSize="11.5" Foreground="{DynamicResource Theme_TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <TextBlock x:Name="FoodModalText" Text="Lezzetler hazırlanıyor..." FontSize="12.5" LineHeight="19" Foreground="{DynamicResource Theme_TextPrimary}" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Afiyet Olsun! 🍕" Width="140" Height="34" HorizontalAlignment="Right" Background="{DynamicResource Theme_Accent}" Foreground="#2B0717" FontWeight="Bold" Cursor="Hand" Click="CloseFoodDiscovery_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>